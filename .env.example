# Internal secret shared by Hub and the arena runtime container.
ARENA_CONTROL_TOKEN=

# Public game API origin shown to bot authors. Keep localhost for local play.
ARENA_PUBLIC_URL=http://localhost:8080

# Local-only published ports. These defaults do not expose the app to the network.
HUB_BIND_ADDRESS=127.0.0.1
HUB_HOST_PORT=8090
ARENA_BIND_ADDRESS=127.0.0.1
ARENA_HOST_PORT=8080

# Bot launch settings (used by scripts/run_*.sh, not passed to Compose services).
# Replace with a team token issued by the StadMagic web app before launching a bot.
DATS_PLAYER_TOKEN=

# Rust player uses the server origin; Java/Node players use the full move endpoint.
DATS_SERVER_URL=http://localhost:8080
DATS_GAME_API_URL=http://localhost:8080/play/magcarp/player/move
DATS_GAME_MODE=api

# Rust player strategy settings.
DATS_PLAYER_STRATEGY=stable-profit
DATS_MOVEMENT_STRATEGY=none
DATS_DOOM_POLICY=collect
