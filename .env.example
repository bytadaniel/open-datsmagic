# Internal secret shared by Hub and the arena runtime container.
ARENA_CONTROL_TOKEN=

# Public game API origin shown to bot authors. Keep localhost for local play.
ARENA_PUBLIC_URL=http://localhost:8080

# Local-only published ports. These defaults do not expose the app to the network.
HUB_BIND_ADDRESS=127.0.0.1
HUB_HOST_PORT=8090
ARENA_BIND_ADDRESS=127.0.0.1
ARENA_HOST_PORT=8080
